---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CatalogViewer from '../components/CatalogViewer.astro';
import BlogRSE from '../components/BlogRSE.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const currentLang = 'es';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>MILOR Comercializadora | Material Eléctrico e Infraestructura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-slate-100 font-['Inter',sans-serif] antialiased selection:bg-amber-500 selection:text-slate-950">
    <Header currentLang={currentLang} />
    <main id="top">
      <Hero currentLang={currentLang} />
      <CatalogViewer currentLang={currentLang} />
      <BlogRSE currentLang={currentLang} />
    </main>
    <Footer currentLang={currentLang} />
  </body>
</html>
