---
interface Props {
  currentLang?: 'es' | 'en';
}

const { currentLang = 'es' } = Astro.props;

const content = {
  es: {
    badge: "Catálogo Técnico & Especificaciones",
    title: "Catálogo de Productos e Infraestructura",
    subtitle: "Consulte nuestro portafolio de aisladores, brazos galvanizados y herrajes eléctricos en alta tensión.",
    previewTitle: "Vista Previa del Catálogo General",
    downloadBtn: "Abrir Catálogo Completo (PDF)",
    driveNotice: "Si la vista previa no carga en su navegador, puede abrir el archivo directamente en Google Drive."
  },
  en: {
    badge: "Technical Catalog & Specifications",
    title: "Product & Infrastructure Catalog",
    subtitle: "Explore our portfolio of insulators, galvanized arms, and high-voltage electrical hardware.",
    previewTitle: "General Catalog Preview",
    downloadBtn: "Open Full Catalog (PDF)",
    driveNotice: "If the preview does not load in your browser, you can open the file directly in Google Drive."
  }
};

const t = content[currentLang] || content.es;

// Enlace directo al visor de Google Drive para embeber (preview) y enlace directo de apertura
const driveEmbedUrl = "https://drive.google.com/file/d/1-8R-W7a9E5Zl4mZk3w4-5_example/preview";
const driveDirectUrl = "https://drive.google.com/file/d/1-8R-W7a9E5Zl4mZk3w4-5_example/view?usp=sharing";
---

<section id="catalogo" class="py-20 bg-slate-900 text-white relative border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 uppercase tracking-wider">
        {t.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        {t.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        {t.subtitle}
      </p>
    </div>

    <!-- Visor de PDF embebido -->
    <div class="bg-slate-950 rounded-2xl p-4 sm:p-6 border border-slate-800 shadow-2xl space-y-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <h3 class="text-lg font-bold text-slate-200">
          {t.previewTitle}
        </h3>
        <a 
          href={driveDirectUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs tracking-wide transition flex items-center gap-2 shadow-lg shadow-amber-500/10"
        >
          <span>📄</span> {t.downloadBtn}
        </a>
      </div>

      <!-- Contenedor Responsivo iframe -->
      <div class="w-full h-[600px] rounded-xl overflow-hidden bg-slate-900 border border-slate-800 relative">
        <iframe 
          src={driveEmbedUrl} 
          class="w-full h-full border-0" 
          allow="autoplay"
          title="Visor de Catálogo MILOR"
        ></iframe>
      </div>

      <p class="text-center text-xs text-slate-500">
        {t.driveNotice}
      </p>
    </div>

  </div>
</section>
