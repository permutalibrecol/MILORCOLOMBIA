---
interface Props {
  currentLang?: 'es' | 'en';
  typeformUrl?: string;
}

const { 
  currentLang = 'es',
  typeformUrl = "https://form.typeform.com/to/tu-id-de-formulario"
} = Astro.props;

const content = {
  es: {
    badge: "Soluciones de Alta Tensión y Material Eléctrico",
    title: "Comercialización y Construcción Eléctrica de Alta Calidad",
    subtitle: "Proveedores líderes en aisladores de porcelana, brazos galvanizados y herrajes industriales para el sector eléctrico en Colombia.",
    typeformBtn: "Solicitar Cotización",
    whatsappBtn: "Atención Inmediata",
    specsTitle: "Cumplimiento Normativo:",
    specs: ["Norma CFE 52000-55", "NMX-J-251", "ANSI C29.3"]
  },
  en: {
    badge: "High Voltage & Electrical Material Solutions",
    title: "High Quality Electrical Construction & Supply",
    subtitle: "Leading suppliers of porcelain insulators, galvanized arms, and industrial fittings for the power sector in Colombia.",
    typeformBtn: "Request Quote",
    whatsappBtn: "Immediate Support",
    specsTitle: "Regulatory Compliance:",
    specs: ["CFE 52000-55 Standard", "NMX-J-251", "ANSI C29.3"]
  }
};

const t = content[currentLang] || content.es;
const whatsappLink = "https://wa.me/573219216097?text=Hola,%20me%20interesa%20recibir%20informaci%C3%B3n%20y%20cotizaci%C3%B3n%20sobre%20el%20material%20el%C3%A9ctrico%20en%20Colombia.";
---

<section class="relative bg-gradient-to-br from-[#0c1938] via-[#142850] to-[#1e3b70] text-white overflow-hidden py-16 lg:py-24 border-b border-blue-900/50">
  
  <!-- Efectos visuales de fondo -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(244,156,18,0.15),transparent_50%)] pointer-events-none"></div>
  <div class="absolute -bottom-10 -left-10 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna Texto y CTA -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Badge -->
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-amber-500/10 border border-amber-500/30 text-amber-400">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          {t.badge}
        </span>

        <!-- Título Principal -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight text-white">
          {t.title}
        </h1>

        <!-- Subtítulo -->
        <p class="text-base sm:text-lg text-blue-100/90 max-w-2xl mx-auto lg:mx-0 font-normal">
          {t.subtitle}
        </p>

        <!-- Botones de Acción (CTA) -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
          
          <!-- Botón Typeform -->
          <a 
            href={typeformUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-center shadow-lg shadow-amber-500/20 transition transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2"
          >
            <span>{t.typeformBtn}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <!-- Botón WhatsApp Colombia -->
          <a 
            href={whatsappLink} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-center shadow-lg shadow-emerald-600/20 transition transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>{t.whatsappBtn}</span>
          </a>

        </div>

        <!-- Normativas / Sellos -->
        <div class="pt-6 border-t border-blue-800/50">
          <span class="text-xs font-semibold text-blue-300 uppercase tracking-wider block mb-2">
            {t.specsTitle}
          </span>
          <div class="flex flex-wrap justify-center lg:justify-start gap-2">
            {t.specs.map(spec => (
              <span class="px-2.5 py-1 rounded bg-blue-950/70 border border-blue-700/50 text-xs font-mono text-blue-200">
                {spec}
              </span>
            ))}
          </div>
        </div>

      </div>

      <!-- Columna Visual Tarjeta Destacada -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl p-6 bg-slate-900/80 border border-blue-700/50 shadow-2xl backdrop-blur-sm">
          <div class="absolute -top-3 -right-3 bg-amber-500 text-slate-950 font-black text-xs px-3 py-1 rounded-full shadow-md">
            COLOMBIA 2026
          </div>
          
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-white flex items-center gap-2">
              <span>⚡</span> Suministros Eléctricos
            </h3>
            <p class="text-sm text-slate-300">
              Aisladores de porcelana tipo carrete, brazos de tubo cédula 30, patines de solera y herrajes para alta y media tensión.
            </p>

            <div class="space-y-2 pt-2">
              <div class="flex items-center justify-between text-xs p-2.5 rounded bg-blue-950/80 border border-blue-900 text-blue-100">
                <span>WhatsApp Colombia:</span>
                <strong class="text-amber-400">+57 321 921 6097</strong>
              </div>
              <div class="flex items-center justify-between text-xs p-2.5 rounded bg-blue-950/80 border border-blue-900 text-blue-100">
                <span>Email Oficial:</span>
                <strong class="text-amber-400">milorcolombia2026@gmail.com</strong>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
