---
interface Props {
  currentLang?: 'es' | 'en';
}

const { currentLang = 'es' } = Astro.props;

// Obtener la URL base de GitHub Pages
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const content = {
  es: {
    tagline: "Comercialización de material eléctrico y soluciones en infraestructura de alta tensión.",
    quickLinks: "Enlaces Rápidos",
    home: "Inicio",
    catalog: "Catálogo Técnico",
    rse: "Responsabilidad Social",
    contact: "Contacto",
    colombiaContact: "Contacto Colombia",
    mexicoContact: "Filial México",
    standards: "Cumplimiento Normativo",
    standardsText: "Nuestros productos cumplen con estrictas normas internacionales de fabricación e ingeniería eléctrica.",
    rights: "Todos los derechos reservados. MILOR Comercializadora y Construcción."
  },
  en: {
    tagline: "Electrical material commercialization and high-voltage infrastructure solutions.",
    quickLinks: "Quick Links",
    home: "Home",
    catalog: "Technical Catalog",
    rse: "CSR & Community",
    contact: "Contact",
    colombiaContact: "Colombia Office",
    mexicoContact: "Mexico Office",
    standards: "Regulatory Compliance",
    standardsText: "Our products strictly comply with international electrical engineering standards.",
    rights: "All rights reserved. MILOR Comercializadora y Construcción."
  }
};

const t = content[currentLang] || content.es;
const currentYear = new Date().getFullYear();
---

<footer id="contacto" class="bg-[#070e1e] text-slate-300 pt-16 pb-8 border-t border-blue-900/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Columna 1: Marca & Descripción -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="bg-amber-500 text-slate-950 font-black text-lg px-2.5 py-1 rounded">
            MILOR
          </div>
          <span class="font-bold tracking-tight text-white leading-tight">
            COMERCIALIZADORA
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {t.tagline}
        </p>
        <div class="flex items-center gap-2 text-xs font-mono text-amber-400 pt-2">
          <span>⚡ CFE 52000-55</span>
          <span>•</span>
          <span>ANSI C29.3</span>
        </div>
      </div>

      <!-- Columna 2: Enlaces Rápidos -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-blue-900/60 pb-2">
          {t.quickLinks}
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href={`${baseUrl}/#top`} class="hover:text-amber-400 transition">{t.home}</a></li>
          <li><a href={`${baseUrl}/#catalogo`} class="hover:text-amber-400 transition">{t.catalog}</a></li>
          <li><a href={`${baseUrl}/#blog`} class="hover:text-amber-400 transition">{t.rse}</a></li>
          <li><a href={`${baseUrl}/#contacto`} class="hover:text-amber-400 transition">{t.contact}</a></li>
        </ul>
      </div>

      <!-- Columna 3: Contacto Colombia -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-blue-900/60 pb-2 flex items-center gap-2">
          <span>🇨🇴</span> {t.colombiaContact}
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-300">
          <li class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">WhatsApp:</span>
            <a href="https://wa.me/573219216097" target="_blank" rel="noopener noreferrer" class="hover:underline font-mono text-amber-300">
              +57 321 921 6097
            </a>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-blue-400 font-bold">Email:</span>
            <a href="mailto:milorcolombia2026@gmail.com" class="hover:underline font-mono text-slate-200">
              milorcolombia2026@gmail.com
            </a>
          </li>
          <li class="text-slate-400 pt-1">
            Atención comercial y suministro directo para proyectos en Colombia.
          </li>
        </ul>
      </div>

      <!-- Columna 4: Filial México & Normativas -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-blue-900/60 pb-2 flex items-center gap-2">
          <span>🇲🇽</span> {t.mexicoContact}
        </h4>
        <p class="text-xs text-slate-400 mb-3">
          {t.standardsText}
        </p>
        <div class="bg-blue-950/60 p-3 rounded-lg border border-blue-900/60 text-xs font-mono space-y-1 text-blue-200">
          <div>• CFE 52000-55</div>
          <div>• NMX-J-251</div>
          <div>• ANSI C29.3</div>
        </div>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-8 border-t border-blue-950 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© {currentYear} {t.rights}</p>
      <div class="flex items-center gap-4 text-slate-400">
        <a href={`${baseUrl}/`} class="hover:text-amber-400 transition">Colombia (ES)</a>
        <a href={`${baseUrl}/`} class="hover:text-amber-400 transition">Colombia (EN)</a>
        <a href={`${baseUrl}/`} class="hover:text-amber-400 transition">México (ES)</a>
      </div>
    </div>

  </div>
</footer>
