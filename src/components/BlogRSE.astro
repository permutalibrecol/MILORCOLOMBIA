---
interface Props {
  currentLang?: 'es' | 'en';
}

const { currentLang = 'es' } = Astro.props;

// URL Base de GitHub Pages
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const content = {
  es: {
    badge: "Compromiso Social & Comunidad",
    title: "Responsabilidad Social Empresarial (RSE)",
    subtitle: "En MILOR creemos que el crecimiento empresarial va de la mano con el desarrollo social, impulsando el talento, la cultura y el deporte.",
    projects: [
      {
        category: "Cultura & Danza",
        title: "Conde Dance Company & Ballet Folklórico Internacional",
        description: "Formación de jóvenes talentos en Chicoloapan con becas del 25% y 50%. Intercambio cultural internacional en Bogotá y embajadas.",
        location: "México / Colombia",
        tag: "Danza & Tradición"
      },
      {
        category: "Arte Plástico",
        title: "Impulso Artístico: Julián David López Trejo",
        description: "Difusión del patrimonio cultural mexicano. Develación del retrato de Sor Juana Inés de la Cruz en la Embajada de México en Bogotá.",
        location: "Bogotá, Colombia",
        tag: "Patrimonio & Arte"
      },
      {
        category: "Deporte de Alto Rendimiento",
        title: "Boxeo en Texcoco & Ciclismo de Montaña",
        description: "Apoyo a atletas en el Campeonato Bike Marathon Interestatal XCO y formación deportiva local como motor de disciplina social.",
        location: "Estado de México",
        tag: "Deporte & Juventud"
      }
    ]
  },
  en: {
    badge: "Social Commitment & Community",
    title: "Corporate Social Responsibility (CSR)",
    subtitle: "At MILOR, business growth goes hand in hand with community development, supporting talent, culture, and sports.",
    projects: [
      {
        category: "Culture & Dance",
        title: "Conde Dance Company & International Folkloric Ballet",
        description: "Training young talents in Chicoloapan with 25% and 50% scholarships. International cultural exchanges in Bogotá and embassies.",
        location: "Mexico / Colombia",
        tag: "Dance & Tradition"
      },
      {
        category: "Fine Arts",
        title: "Artistic Impulse: Julián David López Trejo",
        description: "Promoting Mexican cultural heritage. Unveiling of Sor Juana Inés de la Cruz portrait at the Mexican Embassy in Bogotá.",
        location: "Bogotá, Colombia",
        tag: "Heritage & Art"
      },
      {
        category: "High Performance Sports",
        title: "Texcoco Boxing & Mountain Biking",
        description: "Sponsoring athletes in the XCO Interstate Bike Marathon Championship and promoting sports discipline among youth.",
        location: "State of Mexico",
        tag: "Sports & Youth"
      }
    ]
  }
};

const t = content[currentLang] || content.es;
---

<section id="blog" class="py-20 bg-slate-950 text-white relative border-t border-blue-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header RSE -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 border border-amber-500/30 text-amber-400 uppercase tracking-wider">
        {t.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        {t.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- Grid de Patrocinios y Proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {t.projects.map((item) => (
        <div class="bg-slate-900/80 rounded-2xl border border-blue-900/50 p-6 flex flex-col justify-between hover:border-amber-500/50 transition-all duration-300 shadow-xl group">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs">
              <span class="px-2.5 py-1 rounded bg-blue-950 text-blue-300 font-mono font-medium border border-blue-800/40">
                {item.category}
              </span>
              <span class="text-slate-400 flex items-center gap-1 font-mono">
                📍 {item.location}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors leading-snug">
              {item.title}
            </h3>

            <p class="text-xs text-slate-300 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-[11px] font-mono text-amber-400">
              #{item.tag}
            </span>
            <span class="text-xs text-slate-500 font-medium">
              MILOR Social
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner Inferior de Impacto Cultural -->
    <div class="mt-12 bg-gradient-to-r from-blue-950 via-slate-900 to-blue-950 rounded-2xl p-6 border border-blue-800/40 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">
          🤝 Vínculo Internacional México - Colombia
        </h4>
        <p class="text-xs text-slate-400">
          Apoyo continuo a proyectos que generan identidad, disciplina e intercambio cultural trasfronterizo.
        </p>
      </div>
      <a 
        href="https://wa.me/573219216097?text=Hola,%20quisiera%20conocer%20m%C3%A1s%20sobre%20los%20programas%20de%20patrocinio%20y%20RSE%20de%20MILOR." 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-5 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition whitespace-nowrap"
      >
        Conocer más iniciativas
      </a>
    </div>

  </div>
</section>
